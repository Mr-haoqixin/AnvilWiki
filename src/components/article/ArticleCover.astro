---
/**
 * Optimized cover image for article cards (PRD §14.2 v1.5).
 *
 * Wraps Astro `<Image>` from astro:assets so covers are auto-encoded to WebP
 * and emitted with a responsive srcset. Pass the `ImageMetadata` coming from
 * `entry.data.image` (the content schema's `image()` loader).
 *
 * Sizes hint matches the ListPage grid: 1 col mobile → 2 col sm → 3 col lg
 * inside a max-w-7xl container. Browsers pick the best variant per viewport.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /**
   * Alt text. Required in practice: a cover that is decorative next to a
   * visible title still needs a description for screen readers and image
   * search. The prop stays optional (Astro's Props contract) but a missing
   * value fails the build instead of shipping `alt=""` silently.
   */
  alt?: string;
  class?: string;
  sizes?: string;
}
const {
  src,
  alt,
  class: className = 'mb-3 aspect-video w-full rounded-md object-cover',
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
} = Astro.props;
if (!alt) {
  throw new Error('ArticleCover: `alt` is required — pass the article title.');
}
---

<Image
  src={src}
  alt={alt}
  width={400}
  height={225}
  widths={[200, 400, 800]}
  sizes={sizes}
  format="webp"
  loading="lazy"
  decoding="async"
  class={className}
/>
