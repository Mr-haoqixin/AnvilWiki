---
/**
 * Recent-updates page — all articles in a locale, newest first.
 * High-intent entry point ("x patch notes", "update wiki" queries);
 * pairs with sitemap lastmod for crawl-freshness signals.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { pageTitle, simpleBreadcrumbJsonLd, urlListJsonLd } from '~/lib/seo';
import { detailPath, homeUrl, recentPath } from '~/lib/url';
import { siteUrl } from '~/config/site';

interface Props {
  locale: Locale;
  alternates?: Array<{ hreflang: string; href: string }>;
  /**
   * Zero published articles in this locale = thin empty state — noindex,
   * same treatment as ListPage's empty category lists (page files compute
   * the empty state per locale and pass it in).
   */
  noindex?: boolean;
}
const { locale, alternates = [], noindex = false } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav;
const shared = ui.shared;
const displayLocale = locale === 'en' ? 'zh-CN' : locale;

const title = shared.recentTitle;
const description = shared.recentDescription;

const entries = await getRecentEntries(locale, 200);

const jsonLd = [
  urlListJsonLd({
    name: title,
    items: entries.map((e) => {
      const parsed = parseEntryId(e.id);
      return {
        title: e.data.title,
        url: `${siteUrl}${detailPath(parsed?.category ?? '', parsed?.slug ?? '', locale)}`,
      };
    }),
  }),
  simpleBreadcrumbJsonLd({ pageLabel: title, path: recentPath(locale), locale, homeLabel: nav.home }),
];
---

<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <div class="space-y-6">
    <header>
      <nav class="text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{title}</span>
      </nav>
      <div class="mt-2 flex items-center gap-3">
        <Icon name="lucide:history" class="h-7 w-7 text-nav" />
        <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
      </div>
      <p class="mt-2 max-w-2xl text-muted-foreground">{description}</p>
    </header>

    {
      entries.length === 0 ? (
        <div class="rounded-lg border border-dashed bg-card p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => {
            const parsed = parseEntryId(entry.id);
            const category = parsed?.category ?? '';
            return (
              <a href={detailPath(category, parsed?.slug ?? '', locale)} class="card p-5">
                {entry.data.image && <ArticleCover src={entry.data.image} />}
                <p class="text-xs uppercase tracking-wider text-muted-foreground">{category}</p>
                <h2 class="mt-1 font-semibold leading-snug">{entry.data.title}</h2>
                <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                  {entry.data.description}
                </p>
                <p class="mt-3 text-xs text-muted-foreground">
                  {entry.data.lastModified
                    ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(displayLocale, { timeZone: 'UTC' })}`
                    : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(displayLocale, { timeZone: 'UTC' })}`}
                </p>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</LocaleLayout>
