---
/**
 * Sponsor / donation card (v1.5).
 *
 * Same gating contract as AdSense & Giscus (Hard Rule 11): env empty =
 * component returns null and renders NOTHING. Off by default to preserve
 * the Lighthouse 4×100 out-of-the-box guarantee.
 *
 *   PUBLIC_SPONSOR_URL            — optional donation page link.
 *   PUBLIC_SPONSOR_IMAGE_URL      — optional combined QR / banner image URL or public path.
 */
import { Icon } from 'astro-icon/components';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const sponsorUrl = import.meta.env.PUBLIC_SPONSOR_URL;
const sponsorImage = import.meta.env.PUBLIC_SPONSOR_IMAGE_URL;

// Gate: no donation link or QR image = no card, no DOM, no cost.
if (!sponsorUrl && !sponsorImage) return null;

const ui = getUi(locale);
const shared = ui.shared;
---

<aside class="mt-10 rounded-lg border border-border bg-card p-6 text-center">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4">
    <div class="min-w-0">
      <div class="flex items-center justify-center gap-2">
        <Icon name="lucide:heart" class="h-4 w-4 text-nav" />
        <h2 class="text-base font-bold">{shared.sponsorTitle}</h2>
      </div>
      <p class="mt-1 text-sm text-muted-foreground">{shared.sponsorText}</p>
      {sponsorUrl && (
        <a
          href={sponsorUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-3 inline-flex items-center gap-1.5 px-4 py-2 text-sm"
        >
          <Icon name="lucide:heart-handshake" class="h-4 w-4" />
          {shared.sponsorButton}
        </a>
      )}
    </div>
    {sponsorImage && (
      <img
        src={sponsorImage}
        alt={`${shared.sponsorTitle} — ${shared.sponsorAlipayQr} / ${shared.sponsorWechatQr}`}
        width="834"
        height="456"
        loading="lazy"
        class="block h-auto w-full max-w-2xl rounded-md border border-border object-contain"
      />
    )}
  </div>
</aside>
