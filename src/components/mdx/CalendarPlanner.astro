---
import { getUi } from '~/i18n/ui';

const planner = getUi(Astro.currentLocale ?? 'en').shared.calendarPlanner;
const seasonKeys = ['spring', 'summer', 'fall', 'winter'] as const;
const initialDay = 2;
const initialWeekday = planner.weekdays[(initialDay - 1) % 7];
const initialHeading = planner.dayHeading
  .replace('{season}', planner.seasons[0])
  .replace('{day}', String(initialDay))
  .replace('{weekday}', initialWeekday);
---

<section
  class="not-prose my-8 rounded-xl border border-border bg-card p-4 text-card-foreground md:p-5"
  data-calendar-planner
>
  <h2 class="text-xl font-bold">{planner.title}</h2>
  <p class="mt-1 text-sm text-muted-foreground">{planner.hint}</p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <label class="grid gap-1 text-sm font-medium">
      {planner.seasonLabel}
      <select
        class="rounded-md border border-border bg-background px-3 py-2 text-foreground"
        data-season-select
      >
        {seasonKeys.map((key, index) => (
          <option value={key} selected={index === 0}>{planner.seasons[index]}</option>
        ))}
      </select>
    </label>
    <label class="grid gap-1 text-sm font-medium">
      {planner.dayLabel}
      <select
        class="rounded-md border border-border bg-background px-3 py-2 text-foreground"
        data-day-select
      >
        {Array.from({ length: 14 }, (_, index) => index + 1).map((day) => (
          <option value={day} selected={day === initialDay}>{day}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="mt-4 rounded-lg bg-muted p-4" aria-live="polite" data-calendar-result>
    <h3 class="font-semibold" data-result-heading>{initialHeading}</h3>
    <p class="mt-2 text-sm text-muted-foreground" data-planner-fallback>
      {planner.noJsMessage}
    </p>
    <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-[auto_1fr]" data-result-details></dl>
    <p class="mt-3 hidden text-sm text-muted-foreground" data-no-entry>{planner.noEntry}</p>
    <div class="mt-4 border-t border-border pt-3">
      <h4 class="font-medium">{planner.weeklyTitle}</h4>
      <p class="mt-1 text-sm text-muted-foreground" data-weekly-schedule>
        {planner.weeklySchedule[1]}
      </p>
    </div>
  </div>
  <p class="mt-3 text-xs text-muted-foreground">{planner.dynamicNote}</p>
</section>

<script
  is:inline
  define:vars={{
    seasonNames: planner.seasons,
    weekdayNames: planner.weekdays,
    weeklySchedules: planner.weeklySchedule,
    dayHeadingTemplate: planner.dayHeading,
    labels: {
      weekday: planner.weekdayLabel,
      weather: planner.weatherLabel,
      event: planner.eventLabel,
      time: planner.timeLabel,
    },
  }}
>
  const initializePlanner = () => {
    const plannerRoot = document.querySelector('[data-calendar-planner]');
    if (!(plannerRoot instanceof HTMLElement)) {
      throw new Error('CalendarPlanner: planner root was not rendered.');
    }

    const seasonSelect = plannerRoot.querySelector('[data-season-select]');
    const daySelect = plannerRoot.querySelector('[data-day-select]');
    const heading = plannerRoot.querySelector('[data-result-heading]');
    const details = plannerRoot.querySelector('[data-result-details]');
    const fallback = plannerRoot.querySelector('[data-planner-fallback]');
    const noEntry = plannerRoot.querySelector('[data-no-entry]');
    const weeklySchedule = plannerRoot.querySelector('[data-weekly-schedule]');
    if (
      !(seasonSelect instanceof HTMLSelectElement) ||
      !(daySelect instanceof HTMLSelectElement) ||
      !(heading instanceof HTMLElement) ||
      !(details instanceof HTMLDListElement) ||
      !(fallback instanceof HTMLElement) ||
      !(noEntry instanceof HTMLElement) ||
      !(weeklySchedule instanceof HTMLElement)
    ) {
      throw new Error('CalendarPlanner: expected controls or result elements are missing.');
    }

    const addDetail = (label, value) => {
      const term = document.createElement('dt');
      term.className = 'font-medium';
      term.textContent = label;
      const description = document.createElement('dd');
      description.className = 'text-muted-foreground';
      description.textContent = value;
      details.append(term, description);
    };

    const updatePlanner = () => {
      const day = Number(daySelect.value);
      const weekdayIndex = (day - 1) % 7;
      const seasonIndex = seasonSelect.selectedIndex;
      const weekday = weekdayNames[weekdayIndex];
      heading.textContent = dayHeadingTemplate
        .replace('{season}', seasonNames[seasonIndex])
        .replace('{day}', String(day))
        .replace('{weekday}', weekday);
      weeklySchedule.textContent = weeklySchedules[weekdayIndex];
      details.replaceChildren();

      const tableContainer = document.querySelector(
        `[data-calendar-season-table="${seasonSelect.value}"]`,
      );
      if (!(tableContainer instanceof HTMLElement)) {
        throw new Error(`CalendarPlanner: no table found for season "${seasonSelect.value}".`);
      }

      const rows = Array.from(tableContainer.querySelectorAll('tr'));
      const row = rows.find((candidate) => {
        const firstCell = candidate.cells[0];
        return firstCell !== undefined && firstCell.textContent.trim() === String(day);
      });

      addDetail(labels.weekday, weekday);
      if (row) {
        const values = Array.from(row.cells).map((cell) => cell.textContent.trim());
        if (values[2]) addDetail(labels.weather, values[2]);
        if (values[3]) addDetail(labels.event, values[3]);
        if (values[4]) addDetail(labels.time, values[4]);
        noEntry.classList.add('hidden');
      } else {
        noEntry.classList.remove('hidden');
      }

      fallback.hidden = true;
    };

    seasonSelect.addEventListener('change', updatePlanner);
    daySelect.addEventListener('change', updatePlanner);
    updatePlanner();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePlanner, { once: true });
  } else {
    initializePlanner();
  }
</script>
