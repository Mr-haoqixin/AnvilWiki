---
/**
 * Site header — logo, primary nav, theme toggle, and search.
 * Mobile menu uses native <details> (zero JS).
 */
import { Icon } from 'astro-icon/components';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';
import ThemeToggle from './ThemeToggle.astro';
import SearchButton from './SearchButton.astro';
import { landingLink, landingLinkEnabled } from '~/config/project';

interface Props {
  locale: Locale;
  currentPath: string;
  /** Retained for route call-site compatibility; this game wiki hides locale links. */
  availableLocales?: readonly Locale[];
}
const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const nav: Record<string, string> = ui.nav as Record<string, string>;
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4">
    {/* Logo */}
    <a
      href={localizePath('/', locale)}
      class="flex items-center gap-2 font-bold text-foreground"
      aria-label={site.name}
    >
      <Icon name="lucide:hammer" class="h-6 w-6 text-nav" />
      <span class="hidden sm:inline">{site.shortName}</span>
    </a>

    {/* Desktop nav */}
    <nav class="hidden flex-1 items-center gap-1 md:flex">
      {
        NAVIGATION_CONFIG.map((item) => {
          const path = localizePath(item.path, locale);
          // `path` ends with "/" (trailingSlash:'always') — appending again
          // would produce "//" and silently break child-page highlighting.
          const activePrefix = path.endsWith('/') ? path : path + '/';
          const isActive = currentPath === path || currentPath.startsWith(activePrefix);
          return (
            <a
              href={path}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm font-medium transition',
                isActive
                  ? 'bg-muted text-nav'
                  : 'text-foreground/70 hover:bg-muted hover:text-foreground',
              ]}
            >
              {nav[item.key] ?? item.key}
            </a>
          );
        })
      }
    </nav>

    {/* Right actions */}
    <div class="ml-auto flex items-center gap-1">
      {landingLinkEnabled && (
        <a
          href={landingLink.href}
          class="inline-flex h-9 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground transition hover:bg-muted hover:text-nav"
          aria-label={landingLink.ariaLabel}
          title={landingLink.ariaLabel}
        >
          <Icon name="lucide:hammer" class="h-5 w-5 shrink-0" />
          <span class="hidden whitespace-nowrap lg:inline">{landingLink.label}</span>
        </a>
      )}
      <SearchButton locale={locale} />
      <ThemeToggle />

      {/* Mobile menu */}
      <details class="relative md:hidden">
        <summary
          class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition hover:bg-muted"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-md border bg-card shadow-lg">
          {/* Prominent search entry — mobile readers don't know Cmd+K */}
          <button
            type="button"
            data-open-search
            class="flex w-full items-center gap-2 border-b border-border px-3 py-2.5 text-sm font-medium text-nav transition hover:bg-muted"
          >
            <Icon name="lucide:search" class="h-4 w-4" />
            <span>{nav.search ?? 'Search'}</span>
          </button>
          {
            NAVIGATION_CONFIG.map((item) => (
              <a
                href={localizePath(item.path, locale)}
                class="block px-3 py-2 text-sm transition hover:bg-muted"
              >
                {nav[item.key] ?? item.key}
              </a>
            ))
          }
          {landingLinkEnabled && (
            <a
              href={landingLink.href}
              class="mt-1 flex items-center gap-2 border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
            >
              <Icon name="lucide:hammer" class="h-4 w-4" />
              <span>{landingLink.label}</span>
            </a>
          )}
        </div>
      </details>
    </div>
  </div>
</header>
