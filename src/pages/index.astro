---
/**
 * Root index — handles the default-locale (Chinese) homepage.
 *
 * With `prefixDefaultLocale: false`, the root URL `/` maps here directly
 * (not to /zh/). We render the Chinese homepage inline rather than redirecting,
 * because a redirect adds a round-trip and hurts LCP.
 *
 * Non-default locales use /en/, /ja/, etc., handled by src/pages/[locale]/index.astro.
 */
import HomePage from '~/components/home/HomePage.astro';
import { defaultLocale } from '~/i18n/routing';
import { videoGameJsonLd, websiteJsonLd } from '~/lib/seo';
import { homeUrl, languageAlternates } from '~/lib/url';

const locale = defaultLocale;
const jsonLd = [websiteJsonLd(locale), videoGameJsonLd()];
const alternates = languageAlternates((loc) => homeUrl(loc), [defaultLocale]);
---

<HomePage locale={locale} jsonLd={jsonLd} alternates={alternates} />
